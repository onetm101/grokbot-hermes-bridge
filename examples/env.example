# Copy to .env.local, fill it locally, chmod 600, and never commit it.

HERMES_BRIDGE_SECRET=<generate-a-unique-random-owner-code>
HERMES_BRIDGE_PUBLIC_BASE_URL=https://mcp.example.com
HERMES_BRIDGE_ALLOWED_HOSTS=localhost,127.0.0.1,mcp.example.com
HERMES_BRIDGE_HERMES_BIN=/absolute/path/to/hermes
HERMES_BRIDGE_HERMES_HOME=/absolute/path/to/hermes-home

# Optional limits
# HERMES_BRIDGE_MAX_TURNS=10
# HERMES_BRIDGE_ASK_TIMEOUT_SECONDS=180
# HERMES_BRIDGE_REQUEST_TIMEOUT_SECONDS=190
# HERMES_BRIDGE_MAX_PAYLOAD_BYTES=1048576
# HERMES_BRIDGE_MAX_REQUESTS=60
# HERMES_BRIDGE_RATE_WINDOW_SECONDS=60
# HERMES_BRIDGE_MAX_CONCURRENT=8
# HERMES_BRIDGE_OAUTH_CLIENTS_FILE=/protected/path/oauth-clients.json
